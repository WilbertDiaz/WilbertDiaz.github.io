---
import type { Copy } from '../data/content';

interface Props {
  t: Copy;
}

const { t } = Astro.props as Props;
---
<section class="block pantalla skills" id="skills" aria-labelledby="skills-h">
  <h2 class="titulo" id="skills-h" data-rev style="--i:1">{t.skillsTitle}</h2>


  <div class="sk-envoltura" data-rev style="--i:2">
    <table class="sk-tabla">
      <tbody>
        {t.skillGroups.map((g, gi) =>
          g.rows.map((r, ri) => (
            <tr data-g={gi} class:list={{ 'sk-inicio': ri === 0 }}>
              <th scope="row" class="sk-grupo">{ri === 0 ? g.name : ''}</th>
              <td class="sk-cat">{r.cat}</td>
              <td class="sk-items">
                <ul>
                  {r.items.map((x) => <li>{x}</li>)}
                </ul>
              </td>
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>
</section>

